[Unit]
Description=NovelForge - AI Novel Generation System
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/novelforge
Environment="PYTHONPATH=/opt/novelforge"
ExecStart=/opt/novelforge/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8788
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
