# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mini_hermes

# Data sources
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
POLYGON_API_KEY=
COINBASE_API_KEY=

# LLM
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DECISION_MODEL=claude-haiku-4-5-20251001
NARRATION_MODEL=claude-sonnet-4-6
ENABLE_LLM_DECISION=false
PROMPT_VERSION=1.0

# Risk
INITIAL_CAPITAL_USD=100000
MAX_PER_TRADE_RISK_PCT=0.01
MAX_PER_ASSET_PCT=0.15
MAX_CRYPTO_PCT=0.40
MIN_CASH_RESERVE_PCT=0.20
MAX_DRAWDOWN_PCT=0.10
MIN_CONFIDENCE=65
MIN_RR=1.5
MAX_PER_CORRELATION_GROUP_PCT=0.35

# System
LOG_LEVEL=INFO
TIMEZONE=UTC
ALERT_WEBHOOK_URL=
